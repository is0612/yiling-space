// Yiling Space data model.
// This schema is the intended Phase 0 contract. Run Prisma validation and migration
// generation locally before applying it to any database.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// Two tiers only: one ADMIN who manages accounts, and USERs who own their own characters.
enum UserRole {
  ADMIN
  USER
}

enum CharacterStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PlatformConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  DISABLED
}

enum BindingStatus {
  ACTIVE
  PAUSED
}

enum ExternalIdentityStatus {
  UNVERIFIED
  VERIFIED
  REVOKED
}

enum ExternalIdentityKind {
  UNKNOWN
  HUMAN
  AI
}

enum ExternalIdentityKindSource {
  AUTO
  MANUAL
}

enum FriendChatPolicy {
  DEFAULT
  ALLOW
  BLOCK
}

/// 角色自己对某个平台账号的关系阶段。只用于 EXTERNAL_IDENTITY 类型的 MemoryScope。
enum RelationshipStage {
  STRANGER
  ACQUAINTANCE
  FRIEND
  CLOSE_FRIEND
}

/// 关系当前相处状态，与亲疏阶段分开记录。
enum SocialRelationshipStatus {
  NORMAL
  DISTANT
  CONFLICT
  REPAIRING
  UNOBSERVED
}

enum SocialRelationshipAssessmentTaskStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  FAILED
  PAUSED
}

enum SocialRelationshipAssessmentStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum SocialRelationshipAssessmentOutcome {
  CHANGE
  MAINTAIN
  INSUFFICIENT
  REVIEW
}

enum SocialRelationshipAssessmentEvidenceKind {
  NEW
  CONTEXT
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum MemoryScopeType {
  CHARACTER_GLOBAL
  USER_PRIVATE
  EXTERNAL_IDENTITY
}

enum MemoryCategory {
  FACT
  PREFERENCE
  RELATIONSHIP
  COMMITMENT
  GOAL
  EVENT
  SUMMARY
  OTHER
}

enum MemoryItemStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
  INVALIDATED
  TRASHED
}

/// 人工对「重新提炼提出的长期记忆变化」的处置结果。
enum MemoryReviewDecision {
  ACCEPTED
  IGNORED
}

enum SnapshotKind {
  AUTOMATIC
  MANUAL
}

/// 忆泡的状态。忆泡是「发生过什么」的事实记录，只追加，不做状态机式替代；
/// ARCHIVED 只表示被压缩归档（例如并进阶段总结），仍可回溯。
enum MemoryEventStatus {
  ACTIVE
  ARCHIVED
}

/// 忆泡「还在长」还是「已收口」。
///
/// DRAFT：当天还在累积，新消息会继续往里加；FINAL：昨天已收口，不再改动。
/// 查询不区分两者 —— 「今天做了什么」查 DRAFT，「前天」查 FINAL，同一张表。
enum MemoryEventState {
  DRAFT
  FINAL
}

enum SnapshotStatus {
  CURRENT
  SUPERSEDED
}

enum SnapshotSourceType {
  MESSAGE
  MEMORY_ITEM
  PLATFORM_EVENT
  EXTERNAL_REFERENCE
}

enum MemorySettingsChangePolicy {
  NEXT_CYCLE
  IMMEDIATE_RECALC
}

enum MemoryJobType {
  GENERATE_SNAPSHOT
  REGENERATE_SNAPSHOT
  UPDATE_LONG_TERM_MEMORY
  CLEAN_EXPIRED_MESSAGES
  /// 按天整理忆泡：和 8 天周期无关，昨天的对话第二天就该查得到。
  EXTRACT_EVENTS
  /// 按天写手账：每天一篇，和 8 天周期无关。
  GENERATE_JOURNAL
}

enum MemoryJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  RETRY_WAIT
  CANCELLED
}

enum AuditActorType {
  USER
  SYSTEM
  WORKER
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  username           String             @unique @db.VarChar(100)
  email              String?            @unique @db.VarChar(255)
  registrationIpHash String?            @db.VarChar(64)
  passwordHash       String             @db.VarChar(255)
  displayName        String?            @db.VarChar(120)
  status             UserStatus         @default(ACTIVE)
  role               UserRole           @default(USER)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  ownedCharacters    Character[]        @relation("CharacterOwner")
  linkedIdentities   ExternalIdentity[] @relation("IdentityLinkedUser")
  memoryScopes       MemoryScope[]      @relation("MemoryScopeUser")
  auditLogs          AuditLog[]         @relation("AuditActor")
  sessions           Session[]          @relation("UserSessions")

  @@map("users")
}

model Character {
  id                String                    @id @default(uuid()) @db.Uuid
  ownerId           String                    @db.Uuid
  name              String                    @db.VarChar(100)
  avatar            String?
  basePrompt        String                    @db.Text
  /// 对话示例：只用来对齐语气和用词。聊天与 QQ/B站 被动回复会注入，B站 值班判断不注入。
  styleExamples     String                    @default("") @db.Text
  /// 角色在这个对话里怎么称呼用户（默认「主人」）。空字符串 = 不特意称呼。
  userAddress       String                    @default("主人") @db.VarChar(40)
  modelConfig       Json                      @default("{}") @db.JsonB
  /// 稳定同步根 ID：同一角色在不同设备上的本地实例通过它识别并合并。
  /// 本机新建时等于自己的 id；导入带 origin 的角色继承卡片中的根；无 origin 的老卡
  /// 以新实例自己的 id 建立独立根。一个同步根允许对应多个本地实例，因此不能加唯一约束。
  /// 正常应用创建路径会始终写入；迁移负责回填历史 NULL。
  originCharacterId String?                   @db.Uuid
  status            CharacterStatus           @default(ACTIVE)
  createdAt         DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(6)
  owner             User                      @relation("CharacterOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  channelBindings   CharacterChannelBinding[]
  conversations     Conversation[]
  memoryScopes      MemoryScope[]
  memorySetting     CharacterMemorySetting?
  auditLogs         AuditLog[]                @relation("CharacterAuditLogs")
  proactiveIntents  ProactiveIntent[]
  stickers          CharacterSticker[]
  catchphrases      CharacterCatchphrase[]
  knowledgeCandidates KnowledgeCandidate[]
  knowledgeItems     KnowledgeItem[]

  @@index([ownerId, status])
  @@index([originCharacterId])
  @@index([updatedAt])
  @@map("characters")
}

model PlatformConnection {
  id                    String                    @id @default(uuid()) @db.Uuid
  platform              String                    @db.VarChar(50)
  displayName           String                    @db.VarChar(120)
  platformAccountKey    String?                   @db.VarChar(255)
  status                PlatformConnectionStatus  @default(DISCONNECTED)
  credentialsCiphertext Bytes?                    @db.ByteA
  credentialKeyId       String?                   @db.VarChar(255)
  metadata              Json?                     @db.JsonB
  lastEventAt           DateTime?                 @db.Timestamptz(6)
  createdAt             DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @db.Timestamptz(6)
  characterBindings     CharacterChannelBinding[]
  externalIdentities    ExternalIdentity[]

  @@unique([platform, platformAccountKey])
  @@index([platform, status])
  @@map("platform_connections")
}

model CharacterChannelBinding {
  id               String             @id @default(uuid()) @db.Uuid
  characterId      String             @db.Uuid
  connectionId     String             @db.Uuid
  status           BindingStatus      @default(ACTIVE)
  routingKey       String?            @db.VarChar(255)
  config           Json?              @db.JsonB
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(6)
  character        Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  connection       PlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  conversations    Conversation[]
  biliRoundReports BiliRoundReport[]
  biliSeenVideos   BiliSeenVideo[]
  biliActions      BiliAction[]
  biliDutyLease    BiliDutyLease?
  biliDutyWindowRuns BiliDutyWindowRun[]

  @@unique([characterId, connectionId])
  @@index([status])
  @@map("character_channel_bindings")
}

model ExternalIdentity {
  id           String                 @id @default(uuid()) @db.Uuid
  platform     String                 @db.VarChar(50)
  platformUid  String                 @db.VarChar(255)
  displayName  String?                @db.VarChar(255)
  linkedUserId String?                @db.Uuid
  connectionId String?                @db.Uuid
  status       ExternalIdentityStatus @default(UNVERIFIED)
  /// 对方是真人、AI，还是暂时无法判断。与账号验证状态 status 完全独立。
  kind         ExternalIdentityKind @default(UNKNOWN)
  /// 手动纠正的分类优先；未来自动识别只能更新 AUTO，不能覆盖 MANUAL。
  kindSource   ExternalIdentityKindSource @default(AUTO)
  verifiedAt   DateTime?              @db.Timestamptz(6)
  metadata     Json?                  @db.JsonB
  createdAt    DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(6)
  linkedUser   User?                  @relation("IdentityLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  connection   PlatformConnection?    @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  memoryScopes MemoryScope[]

  @@unique([platform, platformUid])
  @@index([linkedUserId, status])
  @@index([connectionId])
  @@map("external_identities")
}

model MemoryScope {
  id                 String             @id @default(uuid()) @db.Uuid
  characterId        String             @db.Uuid
  scopeType          MemoryScopeType
  scopeKey           String             @unique @db.VarChar(500)
  userId             String?            @db.Uuid
  externalIdentityId String?            @db.Uuid
  /// 以下三个字段只对 EXTERNAL_IDENTITY 范围有意义：这张表同时承担「某角色认识的某个人」
  /// 这条关系 —— `scopeKey` 里带了 characterId，同一个 QQ 号跟两个角色聊过就是两条关系，
  /// 各自记各自的次数和时间，不用再为「朋友」建一张要同步的新表。
  ///
  /// 私聊一进来就 +1；群聊只在她真的回了谁时 +1，不回不算认识。
  lastInteractedAt   DateTime?          @db.Timestamptz(6)
  interactionCount   Int                @default(0)
  /// PRIVATE / GROUP：第一次是怎么认识的。群聊里认识的人后来私聊，这个值不改。
  firstSource        String?            @db.VarChar(20)
  /// 她私下对这个人的叫法（页面上用逗号分隔录入，这里存数组）。
  ///
  /// 和 `externalIdentity.displayName` 并存、不覆盖：那张表存平台名片，对方改一次群名片就变一次；
  /// 这里存「她自己怎么叫」，只在私聊和当前群里的熟人面前用，群里其他人的名单不带。
  /// 按角色隔离 —— 同一个 QQ 号跟两个角色聊过，两边可以叫得完全不一样。
  ///
  /// 上限由 `server/utils/friend-aliases.ts` 归一化时卡住，写入口径只此一处。
  aliases            String[]           @default([])
  /// DEFAULT：真人/未知正常，AI 默认不接话；ALLOW / BLOCK 是这个角色自己的明确选择。
  friendChatPolicy   FriendChatPolicy   @default(DEFAULT)
  /// 仅 EXTERNAL_IDENTITY 范围使用；其他范围保持 null。
  relationshipStage  RelationshipStage?
  /// 当前相处状态，与关系亲疏阶段分开；仅 EXTERNAL_IDENTITY 范围使用。
  relationshipStatus SocialRelationshipStatus?
  /// 乐观并发版本：关系阶段或相处状态变化时递增。
  relationshipVersion Int               @default(0)
  relationshipUpdatedAt DateTime?        @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  character          Character          @relation(fields: [characterId], references: [id], onDelete: Restrict)
  user               User?              @relation("MemoryScopeUser", fields: [userId], references: [id], onDelete: SetNull)
  externalIdentity   ExternalIdentity?  @relation(fields: [externalIdentityId], references: [id], onDelete: SetNull)
  conversations      Conversation[]
  memoryItems        MemoryItem[]
  snapshots          MemorySnapshot[]
  events             MemoryEvent[]
  eventDays          MemoryEventDay[]
  jobs               MemoryJob[]
  journals           CharacterJournal[]
  aliasSuggestions   FriendAliasSuggestion[]
  socialExperiences  SocialExperience[]
  socialRelationChanges SocialRelationChange[]
  socialAssessmentTask SocialRelationshipAssessmentTask?
  socialAssessments SocialRelationshipAssessment[]

  @@index([characterId, scopeType])
  @@index([characterId, interactionCount])
  @@index([userId])
  @@index([externalIdentityId])
  @@map("memory_scopes")
}

model Conversation {
  id                     String                   @id @default(uuid()) @db.Uuid
  characterId            String                   @db.Uuid
  memoryScopeId          String                   @db.Uuid
  channelBindingId       String?                  @db.Uuid
  externalConversationId String?                  @db.VarChar(255)
  title                  String?                  @db.VarChar(255)
  status                 ConversationStatus       @default(ACTIVE)
  metadata               Json?                    @db.JsonB
  /// 连续只包含 AI 发言的群聊轮数；真人参与时清零，达到阈值后暂停 AI-to-AI 对话。
  consecutiveAiRounds    Int                      @default(0)
  lastMessageAt          DateTime?                @db.Timestamptz(6)
  createdAt              DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(6)
  character              Character                @relation(fields: [characterId], references: [id], onDelete: Restrict)
  memoryScope            MemoryScope              @relation(fields: [memoryScopeId], references: [id], onDelete: Restrict)
  channelBinding         CharacterChannelBinding? @relation(fields: [channelBindingId], references: [id], onDelete: SetNull)
  messages               Message[]
  groupMembers           GroupMember[]
  memoryEvents           MemoryEvent[]

  @@unique([channelBindingId, externalConversationId])
  @@index([characterId, updatedAt])
  @@index([memoryScopeId, updatedAt])
  @@map("conversations")
}

model Message {
  id                 String                 @id @default(uuid()) @db.Uuid
  conversationId     String                 @db.Uuid
  externalMessageId  String?                @db.VarChar(255)
  role               MessageRole
  eventType          String                 @default("message") @db.VarChar(80)
  content            String                 @db.Text
  occurredAt         DateTime               @db.Timestamptz(6)
  ingestedAt         DateTime               @default(now()) @db.Timestamptz(6)
  metadata           Json?                  @db.JsonB
  conversation       Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  snapshotSources    MemorySnapshotSource[]
  derivedMemoryItems MemoryItem[]           @relation("MemoryItemSourceMessage")
  derivedEvents      MemoryEvent[]          @relation("MemoryEventSourceMessage")

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("messages")
}

/// 谁在哪个群里说过话。
///
/// 熟客榜要按群分开（「这个群里跟我熟的是谁」）。用不着这张表也能凑出来 ——
/// `messages.metadata->>'authorOpenId'` 里有 QQ 号，但那要扫整段会话的 JSON，
/// 加不了索引，而且随聊天记录线性变慢；关系范围（`MemoryScope`）又只记
/// 「某角色 × 某人」，不记在哪认识的。所以单独一张小表，写入时机就是群聊落库那一轮。
///
/// 只记事实：说了几句、昵称、首末时间。**不记任何消息内容**，也不因她回没回而变 ——
/// 「她在不在这个群」和「她跟这个人熟不熟」是两件事，前者在这里，后者在 `MemoryScope`。
model GroupMember {
  id             String       @id @default(uuid()) @db.Uuid
  /// 群会话：`Conversation.externalConversationId = g:<群号>`
  conversationId String       @db.Uuid
  characterId    String       @db.Uuid
  platformUid    String       @db.VarChar(255)
  displayName    String?      @db.VarChar(255)
  messageCount   Int          @default(0)
  firstSpokeAt   DateTime     @db.Timestamptz(6)
  lastSpokeAt    DateTime     @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, platformUid])
  @@index([conversationId, messageCount])
  @@index([characterId, platformUid])
  @@map("group_members")
}

/// 请求级的幂等与并发锁：同一个 `requestKey` 只处理一次，重复提交拿同一条回复。
/// 没有外键，删角色时由 server/utils/character-delete.ts 显式清理。
model ChatRequest {
  id             String   @id @default(uuid()) @db.Uuid
  ownerId        String   @db.Uuid
  characterId    String   @db.Uuid
  requestKey     String   @db.Uuid
  requestHash    String?  @db.VarChar(64)
  claimToken     String   @db.Uuid
  status         String   @default("PROCESSING") @db.VarChar(20)
  conversationId String?  @db.Uuid
  response       Json?    @db.JsonB
  lastError      String?  @db.VarChar(700)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  @@unique([ownerId, characterId, requestKey])
  @@index([status, updatedAt])
  @@map("chat_requests")
}

model MemoryItem {
  id                String                 @id @default(uuid()) @db.Uuid
  /// 跨设备稳定身份；导入时保留，数据库主键 id 则在目标设备重新生成。
  originId          String                 @default(uuid()) @db.Uuid
  memoryScopeId     String                 @db.Uuid
  category          MemoryCategory
  content           String                 @db.Text
  confidence        Float?
  /// 0..1 的重要度。衰减排序时加权：越高越不容易因为陈旧被丢掉。
  importance        Float                  @default(0.5)
  /// 上次被检索命中并真的注入提示词的时间。衰减优先看它，没有才回落到 updatedAt。
  lastRecalledAt    DateTime?              @db.Timestamptz(6)
  /// 被召回次数。越常用的记忆越稳，避免"总结里提过但很少被用"的条目先被挤掉。
  recallCount       Int                    @default(0)
  status            MemoryItemStatus       @default(ACTIVE)
  statusBeforeTrash MemoryItemStatus?
  deletedAt         DateTime?              @db.Timestamptz(6)
  sourceMessageId   String?                @db.Uuid
  sourceSnapshotId  String?                @db.Uuid
  dedupeKey         String?                @db.VarChar(255)
  validFrom         DateTime?              @db.Timestamptz(6)
  validTo           DateTime?              @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(6)
  memoryScope       MemoryScope            @relation(fields: [memoryScopeId], references: [id], onDelete: Cascade)
  sourceMessage     Message?               @relation("MemoryItemSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  sourceSnapshot    MemorySnapshot?        @relation("MemoryItemDerivedFromSnapshot", fields: [sourceSnapshotId], references: [id], onDelete: SetNull)
  snapshotSources   MemorySnapshotSource[] @relation("MemoryItemSnapshotSources")

  @@unique([memoryScopeId, dedupeKey])
  @@unique([memoryScopeId, originId])
  @@index([memoryScopeId, status, category])
  @@index([memoryScopeId, status, deletedAt])
  @@index([memoryScopeId, validTo])
  @@map("memory_items")
}

model MemorySnapshot {
  id                 String                 @id @default(uuid()) @db.Uuid
  /// 跨设备稳定身份；snapshotKey 仍负责本机任务幂等。
  originId           String                 @default(uuid()) @db.Uuid
  snapshotKey        String                 @db.VarChar(500)
  memoryScopeId      String                 @db.Uuid
  kind               SnapshotKind           @default(AUTOMATIC)
  version            Int                    @default(1)
  periodStart        DateTime               @db.Timestamptz(6)
  periodEnd          DateTime               @db.Timestamptz(6)
  summary            String                 @db.Text
  structuredContent  Json                   @db.JsonB
  status             SnapshotStatus         @default(CURRENT)
  modelMetadata      Json?                  @db.JsonB
  generatedAt        DateTime?              @db.Timestamptz(6)
  createdAt          DateTime               @default(now()) @db.Timestamptz(6)
  memoryScope        MemoryScope            @relation(fields: [memoryScopeId], references: [id], onDelete: Cascade)
  sources            MemorySnapshotSource[]
  derivedMemoryItems MemoryItem[]           @relation("MemoryItemDerivedFromSnapshot")
  derivedEvents      MemoryEvent[]          @relation("MemoryEventSourceSnapshot")
  reviews            MemoryReview[]
  jobs               MemoryJob[]

  @@unique([snapshotKey, version])
  @@unique([memoryScopeId, originId])
  @@index([memoryScopeId, periodStart, periodEnd])
  @@index([memoryScopeId, status, periodEnd])
  @@map("memory_snapshots")
}

model MemorySnapshotSource {
  id           String             @id @default(uuid()) @db.Uuid
  snapshotId   String             @db.Uuid
  sourceType   SnapshotSourceType
  sourceRef    String             @db.VarChar(500)
  messageId    String?            @db.Uuid
  memoryItemId String?            @db.Uuid
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  snapshot     MemorySnapshot     @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  message      Message?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  memoryItem   MemoryItem?        @relation("MemoryItemSnapshotSources", fields: [memoryItemId], references: [id], onDelete: SetNull)

  @@unique([snapshotId, sourceType, sourceRef])
  @@index([messageId])
  @@index([memoryItemId])
  @@map("memory_snapshot_sources")
}

/// 人对某条审核建议的处置。对应快照 structuredContent.memoryChangesApplied[changeIndex]。
/// 单独存表而不回写快照：快照是不可变的审计产物，人的决定不该改它。
model MemoryReview {
  id              String               @id @default(uuid()) @db.Uuid
  snapshotId      String               @db.Uuid
  changeIndex     Int
  decision        MemoryReviewDecision
  /// 采纳后实际写入或受影响的记忆条目；忽略时为空。
  memoryItemId    String?              @db.Uuid
  /// 采纳结果：CREATED / REPLACED / INVALIDATED / DUPLICATE_IGNORED。
  outcome         String?              @db.VarChar(40)
  decidedByUserId String               @db.Uuid
  decidedAt       DateTime             @default(now()) @db.Timestamptz(6)
  snapshot        MemorySnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, changeIndex])
  @@index([snapshotId, decision])
  @@map("memory_reviews")
}

model CharacterMemorySetting {
  id                          String                     @id @default(uuid()) @db.Uuid
  characterId                 String                     @unique @db.Uuid
  snapshotIntervalDays        Int                        @default(3)
  pendingSnapshotIntervalDays Int?
  timezone                    String                     @default("Asia/Shanghai") @db.VarChar(100)
  anchorAt                    DateTime                   @default(now()) @db.Timestamptz(6)
  nextSnapshotAt              DateTime?                  @db.Timestamptz(6)
  autoSnapshotEnabled         Boolean                    @default(true)
  changePolicy                MemorySettingsChangePolicy @default(NEXT_CYCLE)
  rawMessageRetentionDays     Int?
  rawMessageCleanupEnabled    Boolean                    @default(false)
  createdAt                   DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                   @updatedAt @db.Timestamptz(6)
  character                   Character                  @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_memory_settings")
}

model MemoryJob {
  id             String          @id @default(uuid()) @db.Uuid
  memoryScopeId  String          @db.Uuid
  snapshotId     String?         @db.Uuid
  type           MemoryJobType
  idempotencyKey String          @unique @db.VarChar(500)
  periodStart    DateTime?       @db.Timestamptz(6)
  periodEnd      DateTime?       @db.Timestamptz(6)
  status         MemoryJobStatus @default(QUEUED)
  attemptCount   Int             @default(0)
  maxAttempts    Int             @default(3)
  runAt          DateTime        @default(now()) @db.Timestamptz(6)
  lockedAt       DateTime?       @db.Timestamptz(6)
  lockedBy       String?         @db.VarChar(255)
  lastError      String?         @db.Text
  /// 手账任务的显式参数。旧任务为空，Worker 会回退解析幂等键。
  journalDayKey  String?         @db.VarChar(10)
  /// BOTH / DIARY / HANDBOOK。只决定这次补哪一份，不改变已有文本。
  journalTarget  String?         @db.VarChar(20)
  startedAt      DateTime?       @db.Timestamptz(6)
  completedAt    DateTime?       @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  memoryScope    MemoryScope     @relation(fields: [memoryScopeId], references: [id], onDelete: Cascade)
  snapshot       MemorySnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([status, runAt])
  @@index([memoryScopeId, periodStart, periodEnd])
  @@map("memory_jobs")
}

/// 将角色级好友关系与全局/群聊忆泡关联。这里只保存引用，不复制事件正文。
/// 一条忆泡可以涉及多个外部参与者，因此可以分别关联到多条角色级关系。
model SocialExperience {
  id            String      @id @default(uuid()) @db.Uuid
  scopeId       String      @db.Uuid
  memoryEventId String      @db.Uuid
  /// 基于该经历的底层证据消息 ID 集合计算，避免不同记忆范围重复提炼同一批消息时重复累计。
  sourceKey     String      @db.VarChar(64)
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  scope         MemoryScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  memoryEvent   MemoryEvent @relation(fields: [memoryEventId], references: [id], onDelete: Cascade)
  usedInChanges SocialRelationChangeEvidence[]
  usedInAssessments SocialRelationshipAssessmentEvidence[]

  @@unique([scopeId, sourceKey])
  @@index([scopeId, createdAt])
  @@index([memoryEventId])
  @@map("social_experiences")
}

/// 关系阶段变化历史。原因由关系评估/纠错流程提供；证据通过关联表引用忆泡经历。
model SocialRelationChange {
  id             String           @id @default(uuid()) @db.Uuid
  scopeId        String           @db.Uuid
  fromStage      RelationshipStage
  toStage        RelationshipStage
  reason         String           @db.Text
  /// 防止同一评估结果重试时重复写入阶段变化。
  idempotencyKey String           @unique @db.VarChar(500)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  scope          MemoryScope      @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  evidence       SocialRelationChangeEvidence[]

  @@index([scopeId, createdAt])
  @@map("social_relation_changes")
}

/// 一次关系变化使用了哪些独立经历。相同经历可以支持不同朋友的关系判断，
/// 但同一段关系不能在后续变化中重复消费为新的证据。
model SocialRelationChangeEvidence {
  id             String               @id @default(uuid()) @db.Uuid
  changeId       String               @db.Uuid
  experienceId   String               @db.Uuid
  change         SocialRelationChange @relation(fields: [changeId], references: [id], onDelete: Cascade)
  experience     SocialExperience     @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([changeId, experienceId])
  @@index([experienceId])
  @@map("social_relation_change_evidence")
}

/// 「她想给朋友起的备注」的待审建议：由朋友快照提炼时顺带产出，用户点头后才进 `MemoryScope.aliases`。
///
/// 为什么单独一张表而不是直接塞进 aliases：建议需要「状态 + 理由 + 拒绝后不重产」这三件事，
/// 塞进 aliases 数组会污染真正在用的备注。状态机参考梗语录（`CharacterCatchphrase.status`）：
/// PENDING → APPROVED（写入 aliases）/ REJECTED（不删，防下个周期又提同一条）。
///
/// `scopeId` 是关系行（MemoryScope.id），不是 ExternalIdentity.id —— 备注按「角色 × 人」隔离，
/// 删角色时随 MemoryScope 级联清掉（scopeId 有外键）。
/// 每段角色级好友关系一条可复用的评估任务状态；只保存调度状态，不承载执行逻辑。
model SocialRelationshipAssessmentTask {
  id                String                                  @id @default(uuid()) @db.Uuid
  scopeId           String                                  @unique @db.Uuid
  status            SocialRelationshipAssessmentTaskStatus  @default(QUEUED)
  triggerReasons    String[]                                @default([])
  /// 新经历/回顾触发时递增；执行中的新触发留给下一代处理。
  generation        Int                                     @default(0)
  processedGeneration Int                                   @default(0)
  priority          Int                                     @default(0)
  runAt             DateTime                                @default(now()) @db.Timestamptz(6)
  attemptCount      Int                                     @default(0)
  maxAttempts       Int                                     @default(3)
  lockedAt          DateTime?                               @db.Timestamptz(6)
  lockedBy          String?                                 @db.VarChar(255)
  leaseToken        String?                                 @db.Uuid
  leaseExpiresAt    DateTime?                               @db.Timestamptz(6)
  fencingToken      Int                                     @default(0)
  lastError         String?                                 @db.Text
  lastAssessedAt    DateTime?                               @db.Timestamptz(6)
  nextReviewAt      DateTime?                               @db.Timestamptz(6)
  createdAt         DateTime                                @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                                @updatedAt @db.Timestamptz(6)
  scope             MemoryScope                             @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([status, priority, runAt])
  @@map("social_relationship_assessment_tasks")
}

/// 每次实际评估单独留档；失败、证据不足和保持不变都不能覆盖旧记录。
model SocialRelationshipAssessment {
  id                 String                                  @id @default(uuid()) @db.Uuid
  scopeId            String                                  @db.Uuid
  generation         Int
  triggerReasons     String[]                                @default([])
  evaluatedStage     RelationshipStage
  evaluatedStatus    SocialRelationshipStatus
  relationshipVersion Int
  outcome            SocialRelationshipAssessmentOutcome?
  suggestedStage     RelationshipStage?
  suggestedStatus   SocialRelationshipStatus?
  reason             String?                                 @db.Text
  observations       Json?                                   @db.JsonB
  confidence         Float?
  modelProvider      String?                                 @db.VarChar(80)
  modelName          String?                                 @db.VarChar(160)
  promptVersion      String?                                 @db.VarChar(80)
  inputCutoffAt      DateTime?                               @db.Timestamptz(6)
  status             SocialRelationshipAssessmentStatus      @default(RUNNING)
  error              String?                                 @db.Text
  startedAt          DateTime                                @default(now()) @db.Timestamptz(6)
  completedAt        DateTime?                               @db.Timestamptz(6)
  createdAt          DateTime                                @default(now()) @db.Timestamptz(6)
  scope              MemoryScope                             @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  evidence           SocialRelationshipAssessmentEvidence[]

  @@index([scopeId, createdAt])
  @@index([scopeId, relationshipVersion])
  @@index([status, createdAt])
  @@map("social_relationship_assessments")
}

/// 评估引用的经历。NEW 是本轮新增证据，CONTEXT 仅作背景；复用限制由后续证据服务核验。
model SocialRelationshipAssessmentEvidence {
  id             String                                      @id @default(uuid()) @db.Uuid
  assessmentId   String                                      @db.Uuid
  experienceId   String                                      @db.Uuid
  kind           SocialRelationshipAssessmentEvidenceKind
  createdAt      DateTime                                    @default(now()) @db.Timestamptz(6)
  assessment     SocialRelationshipAssessment                @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  experience     SocialExperience                             @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, experienceId])
  @@index([experienceId, kind])
  @@index([assessmentId, kind])
  @@map("social_relationship_assessment_evidence")
}

model FriendAliasSuggestion {
  id        String   @id @default(uuid()) @db.Uuid
  scopeId   String   @db.Uuid
  /// 候选叫法（归一化后，12 字内）。
  alias     String   @db.VarChar(40)
  /// 她为什么这么叫 —— 弹窗上给人看「她凭什么觉得该叫这个」。
  reason    String   @default("") @db.VarChar(200)
  /// PENDING / APPROVED / REJECTED
  status    String   @default("PENDING") @db.VarChar(20)
  /// 规范化键（小写、去空白）：同一关系下同一叫法只提一次，也靠它挡「换个大小写再提一遍」。
  aliasKey  String   @db.VarChar(80)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  scope     MemoryScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([scopeId, aliasKey])
  @@index([status, createdAt])
  @@index([scopeId, status])
  @@map("friend_alias_suggestions")
}

/// QQ 群公告草稿。管理员在群里让角色拟稿，确认后才发布；草稿有有效期，
/// 避免几天后一句「确认发布」把过期内容发出去。
///
/// `characterId` 没有外键，删角色时由 server/utils/character-delete.ts 显式清理。
model OnebotGroupAnnouncement {
  id           String    @id @default(uuid()) @db.Uuid
  connectionId String    @db.Uuid
  groupId      String    @db.VarChar(64)
  requestedBy  String    @db.VarChar(64)
  characterId  String?   @db.Uuid
  topic        String    @db.Text
  content      String    @db.Text
  /// PENDING / PUBLISHING / PUBLISHED / FAILED / EXPIRED / CANCELLED
  status       String    @default("PENDING") @db.VarChar(20)
  error        String?   @db.Text
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt    DateTime  @db.Timestamptz(6)
  publishedAt  DateTime? @db.Timestamptz(6)

  @@index([connectionId, groupId, status, createdAt], map: "onebot_group_announcements_connection_group_status_idx")
  @@map("onebot_group_announcements")
}

/// QQ 空间动作（说说 / 评论）的草稿与发布记录。
///
/// 和 `OnebotGroupAnnouncement` 是两个东西：公告是「群里的一个动作」，这条是「她自己
/// 空间上的一举一动」。分开建表是因为查询完全不同 —— 这里要按天统计「今天发了几条」
/// 来限流，混在公告表里统计会被别的 kind 污染。
///
/// `characterId` 没有外键，删角色时由 server/utils/character-delete.ts 显式清理。
model OnebotQzoneAction {
  id             String    @id @default(uuid()) @db.Uuid
  connectionId   String    @db.Uuid
  characterId    String?   @db.Uuid
  /// POST = 发说说，COMMENT = 评论别人的说说
  kind           String    @db.VarChar(16)
  /// 说说正文，或评论内容
  content        String    @db.Text
  /// 触发方式带来的主题/指令原文，排查「这句是谁让它发的」用
  topic          String    @db.Text
  /// 评论目标：说说主人的 QQ 号
  targetUin      String?   @db.VarChar(64)
  /// 评论目标：那条说说的 tid
  targetTid      String?   @db.VarChar(128)
  /// 目标说说摘要，确认时给人看「你要评论的是这条」
  targetExcerpt  String?   @db.Text
  /// 可见范围：1 公开 / 4 好友 / 64 仅自己（QQ 空间的 ugc_right 编码）
  visible        Int       @default(1)
  /// 触发者 QQ
  requestedBy    String    @db.VarChar(64)
  /// 触发所在会话，回执对得上话
  conversationKey String?  @db.VarChar(128)
  /// PENDING / PUBLISHING / PUBLISHED / FAILED / EXPIRED / CANCELLED
  status         String    @default("PENDING") @db.VarChar(20)
  error          String?   @db.Text
  /// 发布成功后拿到的说说 tid；评论为空
  resultTid      String?   @db.VarChar(128)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime  @db.Timestamptz(6)
  publishedAt    DateTime? @db.Timestamptz(6)

  @@index([connectionId, status, createdAt], map: "onebot_qzone_actions_connection_status_idx")
  @@index([connectionId, kind, publishedAt], map: "onebot_qzone_actions_connection_kind_published_idx")
  @@map("onebot_qzone_actions")
}

model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  actorType   AuditActorType
  actorId     String?        @db.Uuid
  characterId String?        @db.Uuid
  action      String         @db.VarChar(120)
  entityType  String         @db.VarChar(120)
  entityId    String?        @db.VarChar(255)
  details     Json?          @db.JsonB
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  actor       User?          @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  character   Character?     @relation("CharacterAuditLogs", fields: [characterId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([characterId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Server-side login sessions. The browser only holds an opaque token; the database stores its
/// SHA-256 hash, so a leaked database dump cannot be replayed as a valid cookie.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  lastUsedAt DateTime  @default(now()) @db.Timestamptz(6)
  userAgent  String?   @db.VarChar(255)
  ipHash     String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Failed and successful login attempts, used for throttling. Kept in PostgreSQL so multiple
/// instances share the same view of brute-force attempts.
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  username  String   @db.VarChar(100)
  ipHash    String   @db.VarChar(64)
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([username, createdAt])
  @@index([ipHash, createdAt])
  @@map("login_attempts")
}

/// B站值班：每一轮"刷B站"的报告。替代 bili-desk 的 out/<date>.md 文件级报告。
/// 报告正文用 `### BV号` 段落标记"挑中的"视频，宿主按段落数统计本轮挑了几条。
model BiliRoundReport {
  id          String                  @id @default(uuid()) @db.Uuid
  bindingId   String                  @db.Uuid
  day         String                  @db.VarChar(10)
  roundIndex  Int                     @default(1)
  pickedCount Int                     @default(0)
  content     String                  @db.Text
  createdAt   DateTime                @default(now()) @db.Timestamptz(6)
  binding     CharacterChannelBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([bindingId, day, roundIndex])
  @@index([bindingId, createdAt])
  @@map("bili_round_reports")
}

/// B站值班判重表：替代 bili-desk 的 seen.md，记录看过的每一条视频（挑中/跳过都算）。
/// 最近 7 天看过的 BV 不再重复挑，用 bvid 唯一约束保证幂等。
model BiliSeenVideo {
  id        String                  @id @default(uuid()) @db.Uuid
  bindingId String                  @db.Uuid
  bvid      String                  @db.VarChar(32)
  title     String?                 @db.VarChar(255)
  author    String?                 @db.VarChar(120)
  result    String                  @db.VarChar(20)
  reason    String?                 @db.Text
  /// 终判给这条视频打的分（0-20）。null = 这轮没打分（老记录或模型没给）。
  score     Int?
  seenAt    DateTime                @default(now()) @db.Timestamptz(6)
  binding   CharacterChannelBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([bindingId, bvid])
  @@index([bindingId, seenAt])
  @@map("bili_seen_videos")
}

/// 主动找话的「目的池」。
///
/// 目的必须落库，不能每次现编：刚聊完又凑上来、同一句话反复说，都是「每次现编」的典型症状。
/// 一条目的走完 PENDING → SENT（真发出去）/ SKIPPED（这轮放弃）/ EXPIRED（放太久失效）。
model ProactiveIntent {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @db.Uuid
  /// SHARE 分享 / ASK 索取 / INVITE 邀请 / CONFIDE 倾诉 / CURIOUS 好奇 / FOLLOWUP 追问
  kind        String    @db.VarChar(20)
  /// 一句话的目的，用她自己的口吻写。
  goal        String    @db.Text
  /// 0..1：这是不是个真目的。低置信度的存着但不挑中。
  confidence  Float     @default(0.5)
  /// 0..1：放久了会失效的（「他今天说的那个事」）该高一点。
  urgency     Float     @default(0.5)
  /// 来源：memory（长期记忆）/ chat（最近对话）。
  origin      String    @db.VarChar(20)
  /// 去重键，同一角色的同一目的短期不重复。
  dedupeKey   String    @db.VarChar(255)
  /// PENDING / SENT / SKIPPED / EXPIRED
  status      String    @default("PENDING") @db.VarChar(20)
  attempts    Int       @default(0)
  sentAt      DateTime? @db.Timestamptz(6)
  /// 真发出去的正文（发出后才有）。
  content     String?   @db.Text
  /// 发给了谁（平台 + 会话 key），排查用。
  recipient   String?   @db.VarChar(120)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, dedupeKey])
  @@index([characterId, status, createdAt])
  @@map("proactive_intents")
}

/// QQ 群里「安静了多久」的唯一事实来源。
///
/// 群消息平时不落库（她没回话的那一轮一条都不存，只有真的回复才在事务里落消息），
/// 所以「这个群多久没动静」在库里查不到；而判断这件事的 tick 是独立进程，
/// 读不到适配器内存里的 `GroupContext`，只能落一张轻表。
///
/// 没有 relation：这张表只是渠道侧的事实记录，故意不挂外键 ——
/// 但**删角色时必须显式清理**（见 server/utils/character-delete.ts），
/// 解绑渠道时也要清（见 server/api/admin/channels/[id]/bindings/[bindingId].delete.ts），
/// 否则每删一个角色 / 解一次绑就在库里留一批指向已不存在对象的活跃度行。
/// 与 `onebot_group_announcements` 同一个处理方式。
model GroupActivity {
  id                     String    @id @default(uuid()) @db.Uuid
  channelBindingId       String    @db.Uuid
  characterId            String    @db.Uuid
  /// `g:<群号>`，与 Conversation.externalConversationId 同口径。
  externalConversationId String    @db.VarChar(255)
  groupId                String    @db.VarChar(64)
  /// 群里最后一条消息（任何人发的）的收到时刻。
  lastMessageAt          DateTime  @db.Timestamptz(6)
  /// 她最后一次在这个群说话的时刻。
  lastSpokeAt            DateTime? @db.Timestamptz(6)
  /// 她最后一次**真的**主动开了话题（页面展示用）。
  lastInitiativeAt       DateTime? @db.Timestamptz(6)
  /// 最后一次为这个群花过模型调用 —— 成功开口、模型判定不说、报错都算。
  /// 闸门的「最短间隔」看它：不然一个死群会每分钟调一次模型。
  lastAttemptAt          DateTime? @db.Timestamptz(6)
  /// 最近几条群消息当素材：[{ speaker, text, at }]，最多 12 条。
  recentLines            Json?     @db.JsonB
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([channelBindingId, externalConversationId])
  @@index([characterId, lastMessageAt])
  @@map("group_activities")
}

/// B站 的对外动作账本：收藏、发动态。
/// 记在库里而不是内存，是为了做「每天最多几次」「两条动态至少隔多久」这类判定——
/// 进程重启后内存里的计数会归零，账号那边的痕迹删不掉。
model BiliAction {
  id        String                  @id @default(uuid()) @db.Uuid
  bindingId String                  @db.Uuid
  /// 东八区日界，与值班报告的 day 同口径。
  day       String                  @db.VarChar(10)
  /// fav | dynamic
  kind      String                  @db.VarChar(20)
  bvid      String?                 @db.VarChar(32)
  /// 动作内容（动态正文 / 收藏理由），排查用。
  detail    String?                 @db.Text
  createdAt DateTime                @default(now()) @db.Timestamptz(6)
  binding   CharacterChannelBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@index([bindingId, day, kind])
  @@index([bindingId, createdAt])
  @@map("bili_actions")
}

/// B站某个角色绑定当前值班轮次的数据库租约。
///
/// 手动入口和定时适配器最终都进入 runDutyRound，因此按 binding 唯一认领；
/// expiresAt 配合定时续租处理进程崩溃，token 则阻止旧执行者续租或释放新租约。
model BiliDutyLease {
  bindingId String                  @id @db.Uuid
  token     String                  @db.Uuid
  expiresAt DateTime                @db.Timestamptz(6)
  createdAt DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  binding   CharacterChannelBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("bili_duty_leases")
}

/// 每次模型调用的 token 记账。
/// 故意不做外键：账单不应该随角色/会话删除而消失，且这里只用于统计与额度。

/// B站谷时调度窗口的尝试记录，与日报内容分离。
///
/// 没有候选、模型未配置或 CLI 返回错误时，值班流水线可能正常提前返回而不生成日报；
/// 如果调度器只靠 BiliRoundReport.createdAt 重建窗口状态，就会每分钟重复尝试。
/// 这张表在拿到 binding 租约后、开始任何工作前先落一条记录；该窗口本轮无论正常结束、
/// 返回无候选还是进程异常中断，都不会被自动重复触发，以免不确定外部动作是否已发生时重放。
model BiliDutyWindowRun {
  id          String                  @id @default(uuid()) @db.Uuid
  bindingId   String                  @db.Uuid
  /// 窗口业务日；夜间跨午夜窗口使用前一晚的日期。
  businessDay String                  @db.VarChar(10)
  /// noon | night
  windowKey   String                  @db.VarChar(10)
  /// RUNNING | COMPLETED | FAILED
  status      String                  @default("RUNNING") @db.VarChar(20)
  attemptCount Int                    @default(1)
  /// 与 BiliDutyLease.token 对应，用于阻止旧执行者覆盖接管后的结果。
  leaseToken  String                  @db.Uuid
  startedAt   DateTime                @default(now()) @db.Timestamptz(6)
  finishedAt  DateTime?               @db.Timestamptz(6)
  lastError   String?                 @db.Text
  createdAt   DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  binding     CharacterChannelBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([bindingId, businessDay, windowKey])
  @@index([bindingId, createdAt])
  @@index([status, updatedAt])
  @@map("bili_duty_window_runs")
}

model ModelUsage {
  id               String   @id @default(uuid()) @db.Uuid
  /// 调用类别：chat / channel / snapshot / bili-screening / bili-judge / other。
  /// 用字符串而不是 enum：新调用点不该为此再跑一次迁移。
  kind             String   @db.VarChar(40)
  model            String   @db.VarChar(120)
  characterId      String?  @db.Uuid
  userId           String?  @db.Uuid
  conversationId   String?  @db.Uuid
  channelBindingId String?  @db.Uuid
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  /// 思考型模型（如 deepseek-flash）单独统计的 reasoning token。
  reasoningTokens  Int?
  /// 缓存命中的输入 token（DeepSeek 的 prompt_cache_hit_tokens / OpenAI 的 cached_tokens）。
  /// null 表示这次调用没有回传缓存明细（历史数据或供应商不提供），计价只能按未命中价算。
  cacheHitTokens   Int?
  cacheMissTokens  Int?
  metadata         Json?    @db.JsonB
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  @@index([characterId, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
  @@map("model_usages")
}

/// 角色自己的表情包（贴图）：QQ 内置表情之外的「她自己的图」。
/// 图片本体存本地磁盘（.data/stickers/<角色 id>/），库里只放清单与文件名 ——
/// 二进制不该进数据库，迁移时按目录拷走即可；删角色时整目录一起删。
model CharacterSticker {
  id            String    @id @default(uuid()) @db.Uuid
  characterId   String    @db.Uuid
  /// 表情包的名字。**模型看到的就是它**，别写太长也别写编号。
  name          String    @db.VarChar(60)
  /// 什么时候用这张：一句话场景说明，进提示词帮她在十来张里挑对。
  usage         String    @default("") @db.Text
  /// 磁盘文件名（相对 .data/stickers/<characterId>/）。由服务端生成，
  /// 绝不取客户端传来的路径 —— 否则一个 `../` 就能写出目录之外。
  fileName      String    @db.VarChar(120)
  mimeType      String    @db.VarChar(60)
  sizeBytes     Int
  /// 关掉 = 暂时不让她用，但图留着。
  enabled       Boolean   @default(true)
  useCount      Int       @default(0)
  lastUsedAt    DateTime? @db.Timestamptz(6)
  /// 图片内容的 SHA-256，用来给「自动收图」去重：群里同一张图被转发 N 次只收一次。
  contentHash   String?   @db.VarChar(64)
  /// 来源：manual（手动上传）/ collected（群里自动收的）/ qq（从 QQ 收藏夹同步下来的）。
  source        String    @default("manual") @db.VarChar(20)
  /// QQ 收藏表情的 emoji_id（形如 `<QQ号>_0_0_0_<md5>_0_0`）。
  /// 有值 = 这一行和 QQ 收藏夹里那张是同一张：改名要回写备注、删除要连 QQ 一起删。
  /// 空 = 只在本地（还没推上去，或者推失败了）。
  qqEmojiId     String?   @db.VarChar(120)
  /// QQ 图标的 md5（从 emoji_id 里拆出来的那段）。用它认「emoji_id 变了但还是同一张图」——
  /// 在 QQ 里删了又加同一张图，emoji_id 会换，md5 不变。
  qqMd5         String?   @db.VarChar(64)
  /// 回收站：非空即已删。软删而不是直接删，是因为 QQ 那边一删本地就没了，标签全白打。
  deletedAt     DateTime? @db.Timestamptz(6)
  /// 谁删的：local（在本地删的，要同步去删 QQ）/ qq（QQ 那边没了，本地跟着进回收站）。
  deletedReason String?   @db.VarChar(20)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, qqEmojiId])
  @@index([characterId, enabled])
  @@index([characterId, deletedAt])
  /// 自动收图去重：同一个角色下按内容哈希找「这张是不是已经收过」。
  /// 手写迁移 20261030170000 建过这条索引，但一直没写进 schema，Prisma 7 第一次
  /// migrate 就把它当成多余索引删了（20261102064605）。补回来，免得下次再被删。
  @@index([characterId, contentHash])
  @@map("character_stickers")
}

/// 角色的梗语录：她会**原样说出来**的那几句口头禅（「xxx 不烧心吗」）。
///
/// 为什么不塞进 `styleExamples`：那段注入时带着「别把句子原样搬出来」的指令，
/// 是拿来对齐语气的；梗要的恰好是反的 —— 原封不动说出口。两者混在一起会互相抵消。
///
/// 为什么要有独立的表而不是一个长文本框：梗需要「什么时候说」才能挑对时机，
/// 需要 `enabled` 才能说腻了先关掉而不删，需要 `lastUsedAt` 才能防复读 ——
/// 一句连说两天，角色感当场就没了。这三件事长文本框都给不了。
model CharacterCatchphrase {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @db.Uuid
  /// 台词本身。模型会原样使用，所以别写「（可以换成别的说法）」这类批注。
  phrase      String    @db.VarChar(200)
  /// 什么时候说：一句话场景说明，帮模型判断当下是不是这个梗的时机。
  usage       String    @default("") @db.Text
  /// 关掉 = 暂时不说，但留着。
  enabled     Boolean   @default(true)
  /// PENDING / ACTIVE / REJECTED。
  ///
  /// 手动加的直接 ACTIVE；从群里「捡」回来的一律先 PENDING，等用户点头才进候选池 ——
  /// 梗是群体财产，冒用群里的话说错一次就很难收回，不能像表情包那样直接入库存着。
  /// REJECTED 的行**不删**：删了下一轮扫描会把它重新捡回来，等于否不掉。
  status      String    @default("ACTIVE") @db.VarChar(20)
  /// 捡回来时的依据：哪个群、原话几条、出现几次。弹窗要给人看「她凭什么觉得这是梗」。
  evidence    Json?     @db.JsonB
  useCount    Int       @default(0)
  /// 上次说的时刻。冷却靠它算 —— 这是防复读的唯一依据，别只当统计用。
  lastUsedAt  DateTime? @db.Timestamptz(6)
  /// 来源：manual（手填）/ collected（从聊天里捡的）。
  source      String    @default("manual") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, enabled])
  @@index([characterId, status])
  @@map("character_catchphrases")
}

/// 忆泡：一次「发生了什么」的最小完整记录。
///
/// 与 `MemoryItem` 的分工：忆泡是**事实**（只追加、不覆盖），长期记忆是从事实里提炼的
/// **结论**（可以被新条目替代）。混成一条会同时坏掉两件事 —— 后续总结会把「第一次见面」
/// 改掉，而按日期过滤又只能靠正则在正文里翻。
///
/// `participants` 目前存显示名（`member_1` 这类渠道代号也在内），**不是身份引用**：
/// 跨平台身份要经过验证绑定才能合并，这一层留到接入别名表时再做。查询侧只把它当
/// 关键词降级路径，不当成「同一个人」的判据。
model MemoryEvent {
  id               String            @id @default(uuid()) @db.Uuid
  /// 跨设备稳定身份；dedupeKey 仍负责本机抽取任务幂等。
  originId         String            @default(uuid()) @db.Uuid
  memoryScopeId    String            @db.Uuid
  /// 这条忆泡归属哪个会话；null = 旧数据（回填前）或跨会话证据无法收口。
  ///
  /// 群聊的记忆范围是 CHARACTER_GLOBAL，一个范围里挂着好几个群。只按范围检索时，
  /// 「昨天在这个群跟谁聊」会把另一个群的 participants 也算进来
  /// （实况：A 群的两位群友被报成了本群的人）。
  /// 写入时按证据消息的会话收口（已有逻辑），这里把结果存下来供检索过滤。
  conversationId   String?           @db.Uuid
  /// 事件发生的当地日期（角色时区）：2026-10-31。「今天/昨天」按它分组。
  dayKey           String            @db.VarChar(10)
  state            MemoryEventState  @default(DRAFT)
  /// 事件**发生**时间（不是入库时间）。周期快照里的时区换算以此为基准。
  occurredAt       DateTime          @db.Timestamptz(6)
  /// 模糊时段：上午 / 中午 / 下午 / 傍晚 / 晚上 / 深夜。null = 只知道日期。
  timeOfDay        String?           @db.VarChar(20)
  /// 时间精度：exact / part_of_day / day。别把「下午」伪造成 14:00。
  precision        String            @default("day") @db.VarChar(20)
  place            String?           @db.VarChar(200)
  /// 一句话事件，如「和小明在海边游泳」。
  title            String            @db.VarChar(200)
  detail           String            @db.Text
  /// 同义/相关词，给词法检索扩展用（不上向量库时的便宜替代）。
  keywords         String[]          @default([])
  participants     String[]          @default([])
  /// 参与者的结构化引用（`[{kind:"self"|"owner"|"external",…}]`），从证据消息作者推导。
  /// `participants` 是显示名（会改名、会重名、可能是 member_n），两者互补：展示用名字，检索用引用。
  participantRefs  Json?
  confidence       Float?
  sourceMessageId  String?           @db.Uuid
  /// 全部证据消息 id（按时间升序）。`sourceMessageId` 只是第一条，留着兼容旧数据与单条反查。
  sourceMessageIds String[]          @default([])
  sourceSnapshotId String?           @db.Uuid
  /// 幂等键：同一范围同一天同一件事重复提炼时不再插一条。
  dedupeKey        String            @db.VarChar(255)
  status           MemoryEventStatus @default(ACTIVE)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  memoryScope      MemoryScope       @relation(fields: [memoryScopeId], references: [id], onDelete: Cascade)
  conversation     Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  sourceMessage    Message?          @relation("MemoryEventSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  sourceSnapshot   MemorySnapshot?   @relation("MemoryEventSourceSnapshot", fields: [sourceSnapshotId], references: [id], onDelete: SetNull)
  socialExperiences SocialExperience[]

  @@unique([memoryScopeId, dedupeKey])
  @@unique([memoryScopeId, originId])
  @@index([memoryScopeId, occurredAt])
  @@index([memoryScopeId, status, occurredAt])
  @@index([memoryScopeId, dayKey])
  @@index([conversationId, occurredAt])
  @@map("memory_events")
}

/// 某一天忆泡的整理进度。
///
/// 存在的理由有两个：① 幂等 —— 一天只做几次增量抽取，`extractedAt` 之后的消息才是新料；
/// ② 状态 —— DRAFT 表示这一天还在长，FINAL 表示已经收口、不再追加。
model MemoryEventDay {
  id            String           @id @default(uuid()) @db.Uuid
  memoryScopeId String           @db.Uuid
  dayKey        String           @db.VarChar(10)
  state         MemoryEventState @default(DRAFT)
  eventCount    Int              @default(0)
  /// 上次抽取到哪一刻；下一次只处理这之后的新消息，避免每小时都把一整天重跑一遍。
  extractedAt   DateTime?        @db.Timestamptz(6)
  /// 与 extractedAt 组成稳定游标；不设外键，来源消息清理后仍可继续扫描。
  extractedMessageId String?     @db.Uuid
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)
  memoryScope   MemoryScope      @relation(fields: [memoryScopeId], references: [id], onDelete: Cascade)

  @@unique([memoryScopeId, dayKey])
  @@index([memoryScopeId, state])
  @@map("memory_event_days")
}

/// 手账生成状态：ACTIVE = 有正文；SKIPPED = 那天写了、但判断没什么可记的。
///
/// SKIPPED 也要留一行：页面上要能区分「还没到写的时间」和「写了，觉得没什么可记」，
/// 光靠「没有记录」两者长得一样。
enum JournalStatus {
  ACTIVE
  SKIPPED
}

/// 每份文本各自的生成决策状态。
///
/// PENDING：还没有被模型评估过（缺这份文本）。
/// GENERATED：已经有一版可展示的正文（自动生成或人工写）。
/// SKIPPED：模型评估过「今天没什么可写」，`decidedAt` 之后又有新对话才允许重评。
enum JournalTextState {
  PENDING
  GENERATED
  SKIPPED
}

/// 这一版是怎么来的。任何修改都建新版本，界面只展示最新版，旧版可在历史里翻。
enum JournalRevisionType {
  /// 第一次生成（自动任务或手动触发）。
  AI_GENERATED
  /// 用户点了「重写」。
  AI_REWRITE
  /// 用户手工改过。
  USER_EDITED
  /// 恢复自某个旧版本。
  RESTORED
}

/// 同一天的两份独立文本：日记（第一人称叙事）与手账（结构化记录）。
/// 两者共用素材，但独立生成、独立版本、独立编辑；不能拿一份截断当另一份。
enum JournalTextKind {
  DIARY
  HANDBOOK
}

/// 角色手账主体：一个记忆范围、一天一条。
///
/// 它是「这一天」的日期主体，下面挂两份独立文本的版本（`kind` 区分）。
/// 和忆泡的分工：忆泡记「那天发生了什么」（事实、只追加）；日记/手账记
/// 「她怎么过、怎么想」（主观、可修正，每次修改都留版本）。
model CharacterJournal {
  id                String            @id @default(uuid()) @db.Uuid
  memoryScopeId     String            @db.Uuid
  /// 当地日期（角色时区）：2026-10-31。
  dayKey            String            @db.VarChar(10)
  status            JournalStatus     @default(ACTIVE)
  /// SKIPPED 时写一句原因（「没有对话」/「没什么可记的」），页面要能解释为什么没写。
  skipReason        String?           @db.VarChar(300)
  /// DIARY / HANDBOOK 各自的决策状态；整天状态不能代替它们。
  diaryState        JournalTextState  @default(PENDING)
  handbookState     JournalTextState  @default(PENDING)
  /// 上一次对这份文本做出决定的时间；SKIPPED 后只允许评估这天更晚的新对话。
  diaryDecidedAt    DateTime?         @db.Timestamptz(6)
  handbookDecidedAt DateTime?         @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)
  memoryScope       MemoryScope       @relation(fields: [memoryScopeId], references: [id], onDelete: Cascade)
  revisions         JournalRevision[]

  @@unique([memoryScopeId, dayKey])
  @@index([memoryScopeId, dayKey])
  @@map("character_journals")
}

/// 日记 / 手账的完整版本。每次生成/重写/人工修改/恢复都新增一行，绝不无痕覆盖。
///
/// - `DIARY`：第一人称叙事，正文在 `content`。
/// - `HANDBOOK`：结构化记录，正文在 `content`（带小标题与短句），
///   另外保存 `thought`（今日想法）、`quote`（今日一句）、`tags`（标签）。
///   `quote` 必须是某一版日记正文里的连续原文，`sourceDiaryRevisionId` 指向那一版。
model JournalRevision {
  id                    String              @id @default(uuid()) @db.Uuid
  journalId             String              @db.Uuid
  kind                  JournalTextKind     @default(DIARY)
  version               Int
  title                 String?             @db.VarChar(120)
  content               String              @db.Text
  /// 手账的「今日想法」。日记版本里为空。
  thought               String?             @db.Text
  /// 手账的「今日一句」：某一版日记正文里的连续原文。日记版本里为空。
  quote                 String?             @db.Text
  /// 手账的标签（日记版本里为空）。
  tags                  String[]            @default([])
  /// 手账的「今日一句」取自哪一版日记；日记被重写后仍指向当时那一版，便于追溯。
  sourceDiaryRevisionId String?             @db.Uuid
  /// 模型当次引用到的原始消息 id；消息被清理后这里保留指针（历史可查）。
  sourceMessageIds      String[]            @default([])
  /// 当次引用到的忆泡 id。
  sourceEventIds        String[]            @default([])
  revisionType          JournalRevisionType
  /// 生成时的提示词版本，便于回溯「这一版是哪套规则写出来的」。
  promptVersion         String?             @db.VarChar(80)
  model                 String?             @db.VarChar(120)
  /// 人工编辑时记下操作者；自动生成时为空。
  editedByUserId        String?             @db.Uuid
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  journal               CharacterJournal    @relation(fields: [journalId], references: [id], onDelete: Cascade)
  sourceDiaryRevision   JournalRevision?    @relation("JournalQuoteSource", fields: [sourceDiaryRevisionId], references: [id], onDelete: SetNull)
  quotedBy              JournalRevision[]   @relation("JournalQuoteSource")

  @@unique([journalId, kind, version])
  @@index([journalId, kind, version])
  @@map("journal_revisions")
}


/// 知识候选：收集到但尚未正式入库的原始知识线索。
/// 候选保留来源和处理结果；只有明确接受后才会生成 KnowledgeItem。
model KnowledgeCandidate {
  id               String    @id @default(uuid()) @db.Uuid
  characterId      String    @db.Uuid
  sourceType       String    @default("MANUAL") @db.VarChar(20)
  sourceRef        Json?     @db.JsonB
  rawContent       String    @db.Text
  status           String    @default("PENDING") @db.VarChar(20)
  processedResult  Json?     @db.JsonB
  processingError  String?   @db.Text
  processedAt      DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  character        Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  knowledgeItem    KnowledgeItem?

  @@index([characterId, status, createdAt])
  @@index([characterId, createdAt])
  @@map("knowledge_candidates")
}

/// 正式知识条目：与候选分表，避免未经处理的原始内容被直接检索或注入聊天。
model KnowledgeItem {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @db.Uuid
  candidateId String?   @unique @db.Uuid
  title       String    @db.VarChar(240)
  content     String    @db.Text
  category    String    @default("GENERAL") @db.VarChar(40)
  tags        String[]  @default([])
  confidence  Float?
  status      String    @default("ACTIVE") @db.VarChar(20)
  sourceType  String    @default("MANUAL") @db.VarChar(20)
  sourceRef   Json?     @db.JsonB
  revision    Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  candidate   KnowledgeCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([characterId, status, updatedAt])
  @@index([characterId, category, status])
  @@map("knowledge_items")
}
