# dependencies and generated output
node_modules/
.nuxt/
.output/
.data/
.next/
out/
dist/
build/
coverage/

# python virtualenv (bili-agent CLI 独立安装在这里)
.venv/

# local environment and secrets
.env
.env.*
!.env.example
# 本机并行验证用的 compose 覆盖：换容器名与数据卷，避免撞上已有的 yiling-hub-db
docker-compose.override.yml

# local database and backup files
backups/*
!backups/.gitkeep
backups/*.sql
*.dump
*.backup
updates/*.tar
updates/*.tar.gz

# 设计审计截图与原型稿：本地留着看，但不入库——里面有真实聊天记录、QQ 号、群号和用量数据
design/

# 本地临时文件（群聊导出、临时 SQL、转录稿等），只在本地用，不入库
.tmp/

# 个人调研笔记与原始聊天记录（某个群的发言整理、外部工具的使用笔记）：放 .data/notes/，只在本地。
# docs/ 只放工程与产品文档——聊天记录、别人的昵称、真实群号不要写进仓库。
# 这条规矩由 `yarn check:privacy` 执行（scripts/check-privacy.mjs），不再只是注释。
.data/notes/

# logs and OS/editor files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# WorkBuddy workspace memory (agent-local notes, not project source)
# 用 .workbuddy/* 而非 .workbuddy/ ，以便下面可以重新纳入 skills 子目录
.workbuddy/*
# 共享给 AI 的 Agent Skills 属于项目资产，需要入库并随仓库分发
!.workbuddy/skills/

# Prisma local artifacts (keep schema, generated migration SQL, and migrations tracked)
prisma/*.db
prisma/*.db-journal
src/generated/prisma/
