# 使用版配置模板。第一次双击「启动忆灵空间-使用版.bat」时会自动复制成 .env。
#
# 只有 DEV_OWNER_PASSWORD 是你需要记住的：那是网页登录用的管理员密码。
# 其余项不懂的就别改；模型 API Key 不在这里填，登录后在网页里按角色配置（加密存在数据库）。
#
# 这个文件里的 DATABASE_URL 会被 docker-compose.prod.yml 覆盖成容器内网地址，
# 保留它只是为了「同一份 .env 拿去源码目录也能跑」。

# ---------- 数据库（只在使用版内部使用，不对外开端口）----------
POSTGRES_DB=yiling_hub
POSTGRES_USER=yiling_hub
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
DATABASE_URL=postgresql://yiling_hub:__POSTGRES_PASSWORD__@db:5432/yiling_hub?schema=public

# ---------- 网页 ----------
# 使用版默认监听 8801，避开开发版的 3000。
APP_PORT=8801

# ---------- 管理员 ----------
# 首次启动时（库里还没有任何用户）用它建一个 ADMIN 账号；之后以网页里改的密码为准。
DEV_OWNER_ID=00000000-0000-4000-8000-000000000001
DEV_OWNER_USERNAME=admin
DEV_OWNER_PASSWORD=__ADMIN_PASSWORD__

# ---------- 安全 ----------
# 给局域网/公网访问时：把 docker-compose.prod.yml 的端口改成 0.0.0.0，并在反向代理上配 HTTPS，
# 然后把下面这项改成 true（让会话 Cookie 带 Secure）。
YILING_COOKIE_SECURE=false
# 允许别人自助注册（邮箱+密码，不发验证邮件）。只给自己用就保持 false。
YILING_ALLOW_REGISTRATION=false
AUTH_SESSION_TTL_HOURS=12

# ---------- 可选：默认模型回退 ----------
# 通常留空：每个角色在网页里填自己的 API 地址/Key/模型。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CHAT_TIMEOUT_MS=60000
LLM_JOB_TIMEOUT_MS=180000

# ---------- 可选：后台 Worker ----------
# 设为 1 只跑网页、不跑记忆提炼（一般不用改）。
# YILING_WORKER_DISABLED=0
